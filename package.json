{
  "name": "ryadom-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning server/index.mjs --dev",
    "build": "tsc --noEmit && vite build",
    "db:import-sqlite": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning server/import-sqlite.mjs",
    "start": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning server/index.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "mysql2": "3.24.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
